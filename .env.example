# Copiar a .env.local para desarrollo. Nunca subir claves al repositorio (es público).

# ── Web ──────────────────────────────────────────────
# Vacío en local; /clubdelultimomiercoles en GitHub Pages (lo pone pages.yml)
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# private (noindex) | public
NEXT_PUBLIC_SITE_MODE=private

# ── Supabase: públicas por diseño (la seguridad es RLS). Proyecto club-ultimo-miercoles
NEXT_PUBLIC_SUPABASE_URL=https://voplbvbfuxgweyzarqzl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_J5a8zk49xCPHQIxecpXwOg_i7h8M610

# ── Secretos de scripts (en GitHub: Settings → Secrets and variables → Actions → Secrets)
# Google Books: pnpm books consulta solo los libros nuevos o cambiados
GOOGLE_BOOKS_API_KEY=

# Fase 3 — sync con la Sheet CMS
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
# remote (hoy) | storage
COVERS_MODE=remote

# Fase 5 — Instagram
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
